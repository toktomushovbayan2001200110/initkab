{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "build",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "removeComments": false,
    "newLine": "lf",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
